{
  "name": "@wukong/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "pnpm build && node dist/cli.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src --exclude src/**/*.integration.test.ts",
    "test:integration": "vitest run src/queue.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@wukong/ai": "workspace:*",
    "@wukong/assets": "workspace:*",
    "@wukong/core": "workspace:*",
    "@wukong/db": "workspace:*",
    "@wukong/shopline": "workspace:*",
    "bullmq": "^5.80.1",
    "ioredis": "^5.10.1"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
