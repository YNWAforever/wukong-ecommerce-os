{
  "name": "@wukong/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy src/cloudflare.ts --dry-run --config ../../.wrangler/wrangler.generated.jsonc --outdir dist",
    "types": "wrangler types --config ../../.wrangler/wrangler.generated.jsonc",
    "dev:local": "wrangler dev src/cloudflare.ts --local --config ../../.wrangler/wrangler.generated.jsonc",
    "deploy:preview": "node --input-type=module -e \"process.env.CLOUDFLARE_ENV='preview'; await import('../../scripts/render-cloudflare-config.mjs')\" && wrangler deploy src/cloudflare.ts --config ../../.wrangler/wrangler.generated.jsonc",
    "deploy:production": "node --input-type=module -e \"process.env.CLOUDFLARE_ENV='production'; await import('../../scripts/render-cloudflare-config.mjs')\" && wrangler deploy src/cloudflare.ts --config ../../.wrangler/wrangler.generated.jsonc",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src --exclude src/**/*.integration.test.ts",
    "test:integration": "vitest run src/queue.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@wukong/ai": "workspace:*",
    "@wukong/assets": "workspace:*",
    "@wukong/core": "workspace:*",
    "@wukong/db": "workspace:*",
    "@wukong/jobs": "workspace:*",
    "@wukong/shopline": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260718.1",
    "@types/node": "latest",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.112.0"
  }
}
