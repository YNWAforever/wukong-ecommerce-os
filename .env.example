# Names only. Enter sensitive values through the owning provider.
DATABASE_URL=
DATABASE_ADMIN_URL=
QUEUE_INGRESS_URL=
QUEUE_INGRESS_SECRET=
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
AI_PROVIDER=openai
# Keep false until consumer-first rollout, model context/pricing bounds and budget are verified.
# Same non-secret setting on web and Worker; provider credentials remain Worker-only.
LISTING_PAID_OPERATIONS_ENABLED=false
OPENAI_API_KEY=
OPENAI_LISTING_MODEL=gpt-5.6-terra
OPENAI_MODEL=gpt-5.6-terra
# Alternate: explicitly set AI_PROVIDER=openrouter. Blank fields fail when selected.
# Dedicated key: https://openrouter.ai/settings/keys; Cloudflare Worker secret only.
# Model: public catalog plus compatible image/schema endpoint metadata.
OPENROUTER_API_KEY=
OPENROUTER_LISTING_MODEL=
AUTH_SMTP_URL=
AUTH_EMAIL_FROM=
AUTH_SECRET=
BETTER_AUTH_URL=

# Both surfaces need this. The Worker holds it as a secret; the web app reads it
# to store a SHOPLINE credential, and answers 503 on that screen without it.
# Inert under CSV-only operation, where a generated placeholder is correct.
SHOPLINE_TOKEN_ENCRYPTION_KEY=
OPAK_OPERATOR_EMAIL=
# Optional Jev advisory verification; API key is Worker-only.
TYPESAFE_VERIFICATION_MODE=off
TYPESAFE_MODEL=
TYPESAFE_API_KEY=
WEBSITE_FETCH_BASE_URL=

# Product shot server configuration (provider key is Worker-only)
PRODUCT_SHOT_PROVIDER=
PHOTOROOM_API_KEY=
PRODUCT_SHOT_MAX_CALLS_PER_WORKSPACE_PER_DAY=

# Stable web origin for approved product images; HTTPS in production.
PRODUCT_IMAGE_PUBLIC_ORIGIN=

# OpenCode Go: Worker secret only. Never put the key in Vercel or NEXT_PUBLIC variables.
# Select AI_PROVIDER=opencode-go on both producer and Worker after budget approval.
OPENCODE_GO_API_KEY=
OPENCODE_GO_LISTING_MODEL=deepseek-v4.1-flash

# Dormant wine admission: same non-secret flag on Vercel and Worker.
# Accepted operations still drain when false. Enable only after wine runbook gates.
WINE_ENRICHMENT_ENABLED=false
# Worker secret only; full/research require Tavily, storage and document callback.
# Copy/section use accepted evidence without Tavily or storage construction.
TAVILY_API_KEY=
