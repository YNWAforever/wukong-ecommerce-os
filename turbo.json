{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "DATABASE_ADMIN_URL",
    "DATABASE_MIGRATION_URL",
    "DATABASE_MIGRATIONS_DIR",
    "AUTH_SECRET",
    "AUTH_EMAIL_FROM",
    "AUTH_SMTP_URL",
    "BETTER_AUTH_URL",
    "SHOPLINE_TOKEN_ENCRYPTION_KEY",
    "OPAK_OPERATOR_EMAIL",
    "OPENAI_API_KEY",
    "OPENAI_LISTING_MODEL",
    "OPENAI_MODEL",
    "QUEUE_INGRESS_URL",
    "QUEUE_INGRESS_SECRET",
    "S3_BUCKET",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "S3_FORCE_PATH_STYLE",
    "VERCEL_URL",
    "VERCEL_PROJECT_PRODUCTION_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
