{
  "name": "@wukong/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "audit:verify": "tsx src/cli/audit-verify.ts",
    "db:migrate": "tsx src/migrate.ts",
    "quality:backfill": "tsx src/cli/quality-backfill.ts",
    "db:listing-read-preflight": "tsx src/cli/listing-read-preflight.ts",
    "seed:opak": "tsx src/seed-opak.ts",
    "seed:shopline-connection": "tsx src/seed-shopline-connection.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run src/repositories/listings.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:schema-inventory": "tsx src/cli/schema-inventory.ts",
    "db:schema-compatibility": "tsx src/cli/schema-compatibility.ts",
    "db:migration-set": "tsx src/cli/migration-set.ts",
    "db:listing-read-verify": "tsx src/cli/listing-read-verify.ts"
  },
  "dependencies": {
    "@wukong/core": "workspace:*",
    "@wukong/shopline": "workspace:*",
    "drizzle-orm": "^0.44.7",
    "postgres": "^3.4.7",
    "zod": "4.4.3",
    "@wukong/jobs": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "latest",
    "drizzle-kit": "^0.31.7",
    "tsx": "^4.20.6",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
