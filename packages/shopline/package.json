{
  "name": "@wukong/shopline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./bulk-form-xlsx": {
      "types": "./src/bulk-form-xlsx.ts",
      "development": "./src/bulk-form-xlsx.ts",
      "default": "./dist/bulk-form-xlsx.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bulk-form:profile": "tsx src/cli/profile-bulk-form.ts",
    "csv:sample": "tsx src/cli/sample-csv.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@wukong/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "latest",
    "tsx": "^4.20.6",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
